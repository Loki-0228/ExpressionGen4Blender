    { "id": "mouth_corner_up", "mmd": "口角上げ", "mmd_en": "MouthCornerUp", "zh": "嘴角上扬", "panel": "mouth",
      "vrm": "custom:mouthCornerUp", "arkit": ["mouthSmileLeft", "mouthSmileRight"], "arkit_exact": false,
      "parts": [ { "atom": "mouth_smile", "w": 1.0 } ] },

    { "id": "mouth_corner_down", "mmd": "口角下げ", "mmd_en": "MouthCornerDown", "zh": "嘴角下垂", "panel": "mouth",
      "vrm": "custom:mouthCornerDown", "arkit": ["mouthFrownLeft", "mouthFrownRight"], "arkit_exact": false,
      "parts": [ { "atom": "mouth_line02", "w": 1.0 } ] },

    { "id": "contempt", "mmd": "軽蔑", "mmd_en": "Contempt", "zh": "轻蔑", "panel": "eye",

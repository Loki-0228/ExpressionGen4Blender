      "vrm": "angry", "arkit": ["browDownLeft", "browDownRight", "mouthFrownLeft", "mouthFrownRight"], "arkit_exact": false,
      "parts": [ { "atom": "brow_angry", "w": 1.0 }, { "atom": "mouth_angry", "w": 1.0 } ] },

    { "id": "shy", "mmd": "照れ", "mmd_en": "Shy", "zh": "害羞", "panel": "eyebrow",
      "vrm": "relaxed", "arkit": ["cheekSquintLeft", "cheekSquintRight", "mouthSmileLeft", "mouthSmileRight"], "arkit_exact": false,
      "parts": [ { "atom": "brow_shy", "w": 1.0 }, { "atom": "eye_care", "w": 0.7 }, { "atom": "mouth_smile", "w": 0.4 } ] },

    { "id": "shy2", "mmd": "照れ２", "mmd_en": "Shy2", "zh": "害羞（强）", "panel": "eyebrow",
      "vrm": "relaxed", "arkit": ["cheekSquintLeft", "cheekSquintRight"], "arkit_exact": false,
      "parts": [ { "atom": "brow_shy02", "w": 1.0 }, { "atom": "eye_care", "w": 1.0 }, { "atom": "mouth_smile", "w": 0.5 } ] },

    { "id": "tears", "mmd": "涙", "mmd_en": "Tears", "zh": "含泪", "panel": "eye",
      "vrm": "custom:tears", "arkit": [], "arkit_exact": false,
      "parts": [ { "atom": "eye_wail", "w": 0.8 }, { "atom": "eye_highlight_down", "w": 0.5 } ] },

    { "id": "cry", "mmd": "泣き", "mmd_en": "Crying", "zh": "哭", "panel": "eye",
      "vrm": "sad", "arkit": ["browInnerUp", "mouthFrownLeft", "mouthFrownRight"], "arkit_exact": false,
      "parts": [ { "atom": "eye_wail", "w": 1.0 }, { "atom": "brow_trouble", "w": 0.8 }, { "atom": "mouth_line01", "w": 0.5 } ] },

    { "id": "nagomi", "mmd": "なごみ", "mmd_en": "Nagomi", "zh": "温柔祥和", "panel": "eye",
      "vrm": "relaxed", "arkit": ["cheekSquintLeft", "cheekSquintRight"], "arkit_exact": false,
      "parts": [ { "atom": "eye_care", "w": 1.0 }, { "atom": "mouth_smile", "w": 0.5 } ] },

    { "id": "star", "mmd": "星目", "mmd_en": "StarEyes", "zh": "星星眼", "panel": "eye",
      "vrm": "custom:starEyes", "arkit": [], "arkit_exact": false,
      "parts": [ { "atom": "eye_circle", "w": 1.0 } ] },

    { "id": "heart", "mmd": "ハート目", "mmd_en": "HeartEyes", "zh": "爱心眼", "panel": "eye",
      "vrm": "custom:heartEyes", "arkit": [], "arkit_exact": false,
      "parts": [], "unsupported": "参考模型没有对应原子（FBX 里不存在 heart 目标）" },


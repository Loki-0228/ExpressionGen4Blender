    { "id": "hostility", "mmd": "敵意", "mmd_en": "Hostility", "zh": "敌意", "panel": "eye",
      "vrm": "custom:hostility", "arkit": ["browDownLeft", "browDownRight", "eyeSquintLeft", "eyeSquintRight"], "arkit_exact": false,

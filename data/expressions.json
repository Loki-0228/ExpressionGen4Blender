{
  "version": "1.0",
  "name": "Cross-Format Expression Kit",
  "description": "把参考模型的原生表情原子（atoms）组合成一套跨格式通用的标准表情（expressions）。同一份 recipes 可输出 PMX / VRM / Blender / FBX 四种格式。",
  "conventions": {
    "wink_side": {
      "rule": "ウィンク = モデルの右目を閉じる（画面から見て左側）。ウィンク２ = モデルの左目。",
      "verify": "参考模型原子名里的 _L / _R 是「模型自身的左右」还是「观察者的左右」尚未实证。导入后请先单独拉满 Eye_Wink01_L 看是哪只眼闭上；若与 MMD 惯例相反，把 wink / wink2 两条的 atom 互换即可。",
      "switch": "swap_wink_sides"
    },
    "left_right_axis": {
      "rule": "PMX/MMD 中模型面向 -Z，模型左手在 +X。",
      "note": "VRM 1.0 的 blinkLeft/blinkRight 指的是 avatar 自身的左右眼。"
    },
    "vrm_custom_prefix": "vrm 字段以 \"custom:\" 开头的表示 VRM 1.0 没有对应预设，需要用自定义表情名。"
  },
  "formats": {
    "pmx": {
      "primary_name_field": "mmd",
      "secondary_name_field": "mmd_en",
      "implementation": "group morph（形態鍵タイプ0），parts 作为子项写入；原子保留原名放在「その他」枠",
      "panel_map": { "eyebrow": "眉", "eye": "目", "mouth": "口", "other": "その他" }
    },
    "vrm": {
      "primary_name_field": "vrm",
      "implementation": "VRM 1.0 expressions：预设名直接用，custom: 前缀的改用自定义名；bind 指向目标模型对应的 blendshape index",
      "note": "VRM 1.0 预设只有 happy/angry/sad/relaxed/surprised/aa/ih/ou/ee/oh/blink/blinkLeft/blinkRight/lookUp/lookDown/lookLeft/lookRight/neutral 这 18 个，其余必须走 custom。"
    },
    "blender": {
      "primary_name_field": "mmd",
      "implementation": "shape key 重命名 + 用 driver/自定义属性把 parts 组合成群组表情；同时写 ARKit 别名到 shape key 的 vertex group 或自定义属性",
      "note": "Blender 没有 group shape key，需要靠 driver 或 bake 成新 shape key。脚本默认 bake。"
    },
    "fbx": {
      "primary_name_field": "mmd",
      "implementation": "把 BlendShapeChannel 名称改成标准名；parts 需要预先在 DCC 里合成为单一 shape key 后才能一一对应，或保留原子名 + 另出一份 rename map",
      "note": "FBX 的 blendshape 是 per-mesh 的，跨网格（眉/眼/口分属不同 mesh）的群组表情无法用单个 channel 表达，脚本默认输出 rename map。"
    }
  },
  "expressions": [
    { "id": "blink", "mmd": "まばたき", "mmd_en": "Blink", "zh": "眨眼", "panel": "eye",
      "vrm": "blink", "arkit": ["eyeBlinkLeft", "eyeBlinkRight"], "arkit_exact": true,
      "parts": [ { "atom": "eye_wink01_L", "w": 1.0 }, { "atom": "eye_wink01_R", "w": 1.0 } ] },

    { "id": "wink", "mmd": "ウィンク", "mmd_en": "Wink", "zh": "单眼眨（模型右眼）", "panel": "eye",
      "vrm": "blinkRight", "arkit": ["eyeBlinkRight"], "arkit_exact": true,
      "parts": [ { "atom": "eye_wink01_R", "w": 1.0 } ] },

    { "id": "wink2", "mmd": "ウィンク２", "mmd_en": "Wink2", "zh": "单眼眨（模型左眼）", "panel": "eye",
      "vrm": "blinkLeft", "arkit": ["eyeBlinkLeft"], "arkit_exact": true,
      "parts": [ { "atom": "eye_wink01_L", "w": 1.0 } ] },

    { "id": "eye_half", "mmd": "半目", "mmd_en": "HalfLid", "zh": "半睁眼", "panel": "eye",
      "vrm": "custom:halfLid", "arkit": ["eyeSquintLeft", "eyeSquintRight"], "arkit_exact": false,
      "parts": [ { "atom": "eye_half", "w": 1.0 } ] },

    { "id": "jitome", "mmd": "じと目", "mmd_en": "Jitome", "zh": "冷淡眼", "panel": "eye",
      "vrm": "custom:jitome", "arkit": ["eyeSquintLeft", "eyeSquintRight", "browDownLeft", "browDownRight"], "arkit_exact": false,
      "parts": [ { "atom": "eye_half", "w": 1.0 }, { "atom": "brow_serious", "w": 0.6 } ] },

    { "id": "smile", "mmd": "笑い", "mmd_en": "Smile", "zh": "笑（闭眼）", "panel": "eye",
      "vrm": "happy", "arkit": ["eyeBlinkLeft", "eyeBlinkRight", "mouthSmileLeft", "mouthSmileRight"], "arkit_exact": false,
      "parts": [ { "atom": "eye_wink02_L", "w": 1.0 }, { "atom": "eye_wink02_R", "w": 1.0 }, { "atom": "mouth_laugh", "w": 1.0 } ] },

    { "id": "niccori", "mmd": "にっこり", "mmd_en": "Niccori", "zh": "微笑", "panel": "mouth",
      "vrm": "happy", "arkit": ["mouthSmileLeft", "mouthSmileRight", "cheekSquintLeft", "cheekSquintRight"], "arkit_exact": false,
      "parts": [ { "atom": "mouth_smile", "w": 1.0 }, { "atom": "eye_half", "w": 0.5 } ] },

    { "id": "niyari", "mmd": "にやり", "mmd_en": "Niyari", "zh": "坏笑", "panel": "mouth",
      "vrm": "relaxed", "arkit": ["mouthSmileLeft", "mouthSmileRight"], "arkit_exact": false,
      "parts": [ { "atom": "mouth_smile", "w": 0.8 }, { "atom": "eye_half", "w": 0.5 }, { "atom": "brow_smily", "w": 0.6 } ] },

    { "id": "laugh", "mmd": "大笑い", "mmd_en": "Laugh", "zh": "大笑", "panel": "mouth",
      "vrm": "happy", "arkit": ["jawOpen", "mouthSmileLeft", "mouthSmileRight"], "arkit_exact": false,
      "parts": [ { "atom": "mouth_laugh", "w": 1.0 }, { "atom": "eye_wink02_L", "w": 1.0 }, { "atom": "eye_wink02_R", "w": 1.0 } ] },

    { "id": "a", "mmd": "あ", "mmd_en": "A", "zh": "あ 口型", "panel": "mouth",
      "vrm": "aa", "arkit": ["jawOpen"], "arkit_exact": false,
      "parts": [ { "atom": "mouth_a", "w": 1.0 } ] },

    { "id": "i", "mmd": "い", "mmd_en": "I", "zh": "い 口型", "panel": "mouth",
      "vrm": "ih", "arkit": ["mouthSmileLeft", "mouthSmileRight"], "arkit_exact": false,
      "parts": [ { "atom": "mouth_i", "w": 1.0 } ] },

    { "id": "u", "mmd": "う", "mmd_en": "U", "zh": "う 口型", "panel": "mouth",
      "vrm": "ou", "arkit": ["mouthPucker"], "arkit_exact": false,
      "parts": [ { "atom": "mouth_u", "w": 1.0 } ] },

    { "id": "e", "mmd": "え", "mmd_en": "E", "zh": "え 口型", "panel": "mouth",
      "vrm": "ee", "arkit": ["mouthStretchLeft", "mouthStretchRight"], "arkit_exact": false,
      "parts": [ { "atom": "mouth_e", "w": 1.0 } ] },

    { "id": "o", "mmd": "お", "mmd_en": "O", "zh": "お 口型", "panel": "mouth",
      "vrm": "oh", "arkit": ["mouthFunnel"], "arkit_exact": false,
      "parts": [ { "atom": "mouth_o", "w": 1.0 } ] },

    { "id": "n", "mmd": "ん", "mmd_en": "N", "zh": "ん 口型", "panel": "mouth",
      "vrm": "custom:n", "arkit": ["mouthClose"], "arkit_exact": false,
      "parts": [ { "atom": "mouth_n", "w": 1.0 } ] },

    { "id": "o2", "mmd": "お２", "mmd_en": "O2", "zh": "お 口型（备用形状）", "panel": "mouth",
      "vrm": "custom:o2", "arkit": ["mouthFunnel"], "arkit_exact": false,
      "parts": [ { "atom": "mouth_o2", "w": 1.0 } ] },

    { "id": "surprised", "mmd": "びっくり", "mmd_en": "Surprised", "zh": "惊讶", "panel": "eye",
      "vrm": "surprised", "arkit": ["browInnerUp", "eyeWideLeft", "eyeWideRight", "jawOpen"], "arkit_exact": false,
      "parts": [ { "atom": "eye_surprised", "w": 1.0 }, { "atom": "mouth_o2", "w": 0.8 }, { "atom": "brow_up", "w": 0.6 } ] },

    { "id": "surprise_s", "mmd": "驚き小", "mmd_en": "SurprisedSmall", "zh": "小惊讶", "panel": "eye",
      "vrm": "custom:surprisedSmall", "arkit": ["eyeWideLeft", "eyeWideRight"], "arkit_exact": false,
      "parts": [ { "atom": "eye_surprised03", "w": 1.0 }, { "atom": "mouth_o", "w": 0.5 } ] },

    { "id": "troubled", "mmd": "困る", "mmd_en": "Troubled", "zh": "为难", "panel": "eyebrow",

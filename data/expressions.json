      "parts": [ { "atom": "eye_look_down", "w": 1.0 } ] },

    { "id": "look_left", "mmd": "左", "mmd_en": "LookLeft", "zh": "向左看", "panel": "eye",
      "vrm": "lookLeft", "arkit": ["eyeLookOutLeft", "eyeLookInRight"], "arkit_exact": true,
      "parts": [ { "atom": "eye_look_left", "w": 1.0 } ] },

    { "id": "look_right", "mmd": "右", "mmd_en": "LookRight", "zh": "向右看", "panel": "eye",
      "vrm": "lookRight", "arkit": ["eyeLookInLeft", "eyeLookOutRight"], "arkit_exact": true,
      "parts": [ { "atom": "eye_look_right", "w": 1.0 } ] },

    { "id": "look_close", "mmd": "寄り目", "mmd_en": "CrossEyes", "zh": "斗鸡眼", "panel": "eye",
      "vrm": "custom:crossEyes", "arkit": ["eyeLookInLeft", "eyeLookInRight"], "arkit_exact": false,
      "parts": [ { "atom": "eye_look_close", "w": 1.0 } ] },

    { "id": "highlight_off", "mmd": "ハイライト消", "mmd_en": "HighlightOff", "zh": "关闭眼高光", "panel": "eye",
      "vrm": "custom:highlightOff", "arkit": [], "arkit_exact": false,
      "parts": [ { "atom": "eye_highlight_off", "w": 1.0 } ] },

    { "id": "serious", "mmd": "真面目", "mmd_en": "Serious", "zh": "认真", "panel": "eyebrow",
